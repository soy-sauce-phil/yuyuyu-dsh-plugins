{
  "name": "@soy-sauce-phil/dsh-dockhub",
  "version": "0.1.3",
  "description": "One sidebar entry that collects every widget into a launcher grid.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "author": "soy-sauce-phil",
  "repository": {
    "type": "git",
    "url": "https://github.com/soy-sauce-phil/yuyuyu-dsh-plugins",
    "directory": "dsh-dockhub"
  },
  "homepage": "https://github.com/soy-sauce-phil/yuyuyu-dsh-plugins/tree/main/dsh-dockhub#readme"
}
