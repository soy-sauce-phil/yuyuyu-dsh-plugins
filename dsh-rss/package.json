{
  "name": "@soy-sauce-phil/dsh-rss",
  "version": "0.1.5",
  "description": "RSS / Atom reader in the sidebar: subscriptions, unread counts, OPML import/export, in-card reading.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "net.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT",
  "author": "soy-sauce-phil",
  "repository": {
    "type": "git",
    "url": "https://github.com/soy-sauce-phil/yuyuyu-dsh-plugins",
    "directory": "dsh-rss"
  },
  "homepage": "https://github.com/soy-sauce-phil/yuyuyu-dsh-plugins/tree/main/dsh-rss#readme"
}
